{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build C application",
      "type": "process",
      "command": "python3",
      "args": [
        "scripts/build.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build",
      "windows": {
        "command": "python"
      }
    },
    {
      "label": "Run automated tests",
      "type": "process",
      "command": "python3",
      "args": [
        "tests/run_tests.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "windows": {
        "command": "python"
      }
    }
  ]
}
